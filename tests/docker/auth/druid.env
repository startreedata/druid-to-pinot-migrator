DRUID_SINGLE_NODE_CONF=micro-quickstart

druid_emitter_logging_logLevel=warn

# druid-basic-security adds the basic authenticator + authorizer used below.
druid_extensions_loadList=["druid-histogram", "druid-datasketches", "druid-lookups-cached-global", "postgresql-metadata-storage", "druid-multi-stage-query", "druid-kafka-indexing-service", "druid-basic-security"]

druid_zk_service_host=zookeeper

druid_metadata_storage_host=
druid_metadata_storage_type=postgresql
druid_metadata_storage_connector_connectURI=jdbc:postgresql://postgres:5432/druid
druid_metadata_storage_connector_user=druid
druid_metadata_storage_connector_password=druid

druid_coordinator_balancer_strategy=cachingCost

druid_indexer_runner_javaOptsArray=["-server", "-Xmx1g", "-Xms1g", "-XX:MaxDirectMemorySize=3g", "-Duser.timezone=UTC", "-Dfile.encoding=UTF-8", "-Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager"]
druid_indexer_fork_property_druid_processing_buffer_sizeBytes=256MiB

druid_storage_type=local
druid_storage_storageDirectory=/opt/shared/segments

druid_indexer_logs_type=file
druid_indexer_logs_directory=/opt/shared/indexing-logs

druid_processing_numThreads=2
druid_processing_numMergeBuffers=2

druid_query_groupBy_defaultStrategy=v2

# ── Druid Basic auth ─────────────────────────────────────────────────────
# Authenticator chain: a single 'basic' authenticator backed by the metadata DB.
# Initial admin password and internal-system password seed at first boot —
# they're idempotent on subsequent boots.
druid_auth_authenticatorChain=["basic"]
druid_auth_authenticator_basic_type=basic
druid_auth_authenticator_basic_initialAdminPassword=admin
druid_auth_authenticator_basic_initialInternalClientPassword=internalpass
druid_auth_authenticator_basic_credentialsValidator_type=metadata
druid_auth_authenticator_basic_skipOnFailure=false
druid_auth_authenticator_basic_authorizerName=basic

# Authorizer: the 'basic' authorizer accepts the admin user from above with
# full permissions; everything else is rejected.
druid_auth_authorizers=["basic"]
druid_auth_authorizer_basic_type=basic

# Escalator: how Druid's own services authenticate to each other (coordinator
# → overlord etc.) using the internal-system credential.
druid_escalator_type=basic
druid_escalator_internalClientUsername=druid_system
druid_escalator_internalClientPassword=internalpass
druid_escalator_authorizerName=basic

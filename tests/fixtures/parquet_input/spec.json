{
  "type": "index_parallel",
  "spec": {
    "dataSchema": {
      "dataSource": "telemetry",
      "timestampSpec": {
        "column": "ts",
        "format": "millis"
      },
      "dimensionsSpec": {
        "dimensions": ["region", "service", "host"]
      },
      "metricsSpec": [
        {"type": "count",   "name": "events"},
        {"type": "longSum", "name": "latency_sum", "fieldName": "latency_ms"}
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "MINUTE",
        "rollup": true,
        "intervals": ["2024-01-01/2024-02-01"]
      }
    },
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "s3",
        "uris": ["s3://prod-telemetry/year=2024/month=01/"]
      },
      "inputFormat": {
        "type": "parquet",
        "binaryAsString": false
      }
    }
  }
}

{
  "type": "index_parallel",
  "spec": {
    "dataSchema": {
      "dataSource": "pageviews",
      "timestampSpec": {
        "column": "timestamp",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": ["page", "user", "region"]
      },
      "metricsSpec": [],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "DAY",
        "queryGranularity": "NONE",
        "rollup": false,
        "intervals": ["2024-01-01/2024-02-01"]
      }
    },
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/data/pageviews",
        "filter": "*.json"
      },
      "inputFormat": {
        "type": "json"
      }
    }
  }
}

{
  "type": "index_parallel",
  "spec": {
    "dataSchema": {
      "dataSource": "audit_events",
      "timestampSpec": {
        "column": "event_time",
        "format": "millis"
      },
      "dimensionsSpec": {
        "dimensions": ["actor", "action", "resource"]
      },
      "metricsSpec": [
        {"type": "count",   "name": "events"},
        {"type": "longSum", "name": "bytes_sum", "fieldName": "bytes"}
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "MINUTE",
        "rollup": true,
        "intervals": ["2024-01-01/2024-02-01"]
      }
    },
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "s3",
        "uris": ["s3://prod-audit/year=2024/"]
      },
      "inputFormat": {
        "type": "avro_ocf"
      }
    }
  }
}
